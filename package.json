{
  "name": "packforge-ui",
  "version": "0.1.1",
  "description": "Minecraft-style React components for PackForge: pixel controls, two themes, pixel icons.",
  "license": "MIT",
  "author": "Andrix03",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrix03/packforge-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build-icons.mjs && vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "icons": "node scripts/build-icons.mjs",
    "gallery": "vite --config vite.gallery.config.ts",
    "gallery:build": "vite build --config vite.gallery.config.ts",
    "check": "node scripts/check.mjs",
    "test": "vitest run",
    "format": "prettier --write src gallery scripts README.md CHANGELOG.md",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
